# Build stage
FROM docker.io/library/golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum *.go ./
RUN go build -o ai-log-agent .

# Run stage
FROM docker.io/library/alpine:latest
WORKDIR /app
COPY --from=builder /app/ai-log-agent /app/ai-log-agent
CMD ["/app/ai-log-agent", "--config", "/etc/ai-log-agent/agent.yaml"]
